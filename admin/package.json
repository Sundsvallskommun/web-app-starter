{
  "name": "@sk-web-gui/web-app-starter-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv next dev",
    "build": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=1 dotenv next build",
    "start": "dotenv next start",
    "generate:contracts": "cross-env NODE_ENV=development npx tsx ./src/swagger-typescript-api.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:strict": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=1 eslint src/ --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --pretty --noEmit",
    "knip": "knip",
    "knip:production": "knip --production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build"
  },
  "dependencies": {
    "@sk-web-gui/core": "4.6.1",
    "@sk-web-gui/react": "3.1.2",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "dotenv-cli": "^11.0.0",
    "envalid": "^8.1.1",
    "i18next": "^26.4.0",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "next-i18next": "^16.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.86.0",
    "react-i18next": "^17.0.12",
    "sass": "^1.103.1",
    "sharp": "^0.35.4",
    "underscore.string": "^3.3.6",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/underscore.string": "0.0.42",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "cross-env": "^10",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.1.1",
    "knip": "^6.32.3",
    "postcss": "^8.5.26",
    "postcss-import": "^16.2.0",
    "prettier": "^3.9.6",
    "swagger-typescript-api": "^13.12.6",
    "tailwindcss": "^3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    "defaults and fully supports es6-module",
    "maintained node versions"
  ],
  "resolutions": {
    "next/sharp": "0.35.3"
  }
}
