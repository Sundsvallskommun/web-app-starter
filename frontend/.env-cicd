# Build-time placeholders for CI/CD.
#
# Next inlines NEXT_PUBLIC_* into the client bundle at build time, so a real value
# baked here would lock the image to one environment. Build against placeholders
# instead; entrypoint.sh swaps them for the container's environment variables at
# startup, which lets a single image per commit serve every environment.
#
# Keep the placeholder name identical to the variable name — entrypoint.sh derives
# one from the other.
NEXT_PUBLIC_APP_NAME=NEXT_PUBLIC_APP_NAME_PLACEHOLDER
NEXT_PUBLIC_API_URL=NEXT_PUBLIC_API_URL_PLACEHOLDER
NEXT_PUBLIC_PROTECTED_ROUTES=NEXT_PUBLIC_PROTECTED_ROUTES_PLACEHOLDER
DOMAIN_NAME=DOMAIN_NAME_PLACEHOLDER
ADMIN_URL=ADMIN_URL_PLACEHOLDER

# basePath is resolved by next.config.js while building and cannot be swapped at
# runtime; Next also rejects any value that is neither empty nor prefixed with "/".
# Serving under a path prefix therefore requires a real value here, not a placeholder.
BASE_PATH=
NEXT_PUBLIC_BASE_PATH=
