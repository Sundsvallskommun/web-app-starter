{
  "name": "@sk-web-gui/web-app-starter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "yarn generate:middleware-envs",
    "dev": "cross-env TEST=true next dev",
    "prebuild": "yarn generate:middleware-envs",
    "build": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=1 next build",
    "prebuild:test": "yarn generate:middleware-envs",
    "build:test": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=1 TEST=true next build",
    "start": "next start",
    "generate:middleware-envs": "node middleware-envs-generator.mjs",
    "generate:contracts": "cross-env NODE_ENV=development npx tsx ./src/swagger-typescript-api.ts",
    "lint": "eslint src/ e2e/",
    "lint:fix": "eslint src/ e2e/ --fix",
    "lint:strict": "cross-env BROWSERSLIST_IGNORE_OLD_DATA=1 eslint src/ e2e/ --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write \"{src,e2e}/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"{src,e2e}/**/*.{ts,tsx}\"",
    "type-check": "tsc --pretty --noEmit",
    "knip": "knip",
    "knip:production": "knip --production",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build"
  },
  "dependencies": {
    "@sk-web-gui/core": "4.6.2",
    "@sk-web-gui/react": "3.1.3",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.2",
    "i18next-resources-to-backend": "^1.2.3",
    "lodash": "4.18.1",
    "next": "16.3.5",
    "next-i18n-router": "^5.5.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "sass": "^1.104.1",
    "sharp": "^0.35.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "cross-env": "^10",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^29.1.1",
    "knip": "^6.36.0",
    "postcss": "^8.5.28",
    "postcss-import": "^16.2.0",
    "prettier": "^3.9.8",
    "swagger-typescript-api": "^13.12.6",
    "tailwindcss": "^3.4.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "browserslist": [
    "defaults and fully supports es6-module"
  ],
  "resolutions": {
    "next/sharp": "0.35.3"
  }
}
